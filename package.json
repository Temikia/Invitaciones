{
  "name": "camila-xv-invitacion",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:recuerdos": "node --env-file=.env scripts/dev-memories.mjs",
    "dev:seguridad": "node --env-file=.env scripts/dev-memories.mjs --security",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "drive:authorize": "node scripts/authorize-drive.mjs",
    "assets:prepare": "node scripts/prepare-assets.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "gsap": "^3.13.0",
    "lucide-react": "^0.468.0",
    "qrcode.react": "^4.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "~5.9.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "sharp": "^0.35.5"
  }
}
